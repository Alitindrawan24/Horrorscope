# Google AI Studio (Gemini) API key.
# Get yours from: https://aistudio.google.com/app/apikey
# Copy this file to .env.local and fill in the value.
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model used for summoning curses.
# Defaults to "gemini-3.6-flash". If the chosen model is retired or your key
# can't access it, the app automatically calls ListModels and retries with an
# available Flash model, so you usually don't need to set this.
# Examples: gemini-3.8-flash, gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.6-flash
